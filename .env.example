# Local automation worker (copy this file to .env.local)
API_URL=https://email.api.yingmu-tech.com
AUTOMATION_WORKER_TOKEN=replace-with-the-same-worker-secret
WORKER_ID=local-worker-1
POLL_INTERVAL_MS=5000
DRY_RUN=true
HEADLESS=true

# Optional. Without it, Campaigns must provide public directory/source URLs.
BRAVE_SEARCH_API_KEY=
